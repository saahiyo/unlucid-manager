# Add your cookies JSON string here
# On Vercel, add this as an Environment Variable named VITE_COOKIES
VITE_COOKIES='{"my_account":{"gmail":"...","__Secure-authjs.callback-url":"...","__Secure-authjs.session-token":"..."}}'

# Server-side auto-claim (Vercel Cron /api/cron/auto-claim).
# Prefer UNLUCID_COOKIES so cookies are not required in the client bundle for cron.
# Same JSON shape as VITE_COOKIES. Falls back to VITE_COOKIES if unset.
# UNLUCID_COOKIES='{"my_account":{"__Secure-authjs.session-token":"..."}}'

# Required to authorize cron + manual triggers:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-string

# Optional: override API base if the owned proxy is hosted separately.
# Leave empty to use same-origin /api (Vite middleware locally, Vercel /api in production).
# VITE_API_BASE=https://your-proxy.vercel.app

# Add your cookies JSON string here (optional bootstrap for the dashboard).
# On Vercel, add this as an Environment Variable named VITE_COOKIES
# VITE_COOKIES='{"my_account":{"gmail":"...","__Secure-authjs.callback-url":"...","__Secure-authjs.session-token":"..."}}'

# --- Server auto-claim + cookie sync (set once) ---

# Required to authorize cron + dashboard→server sync:
# Authorization: Bearer <same value>
CRON_SECRET=change-me-to-a-long-random-string

# Same secret for the browser so Update cookies can sync to the server.
# Use the identical value as CRON_SECRET (personal deploy).
VITE_SYNC_SECRET=change-me-to-a-long-random-string

# Upstash Redis — connect via Vercel Storage / Marketplace (auto-injects these):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (Classic Upstash names also work: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)


# Optional bootstrap / fallback if Redis is empty:
# UNLUCID_COOKIES='{"my_account":{"__Secure-authjs.session-token":"..."}}'

# Optional: override API base if the owned proxy is hosted separately.
# Leave empty to use same-origin /api (Vite middleware locally, Vercel /api in production).
# VITE_API_BASE=https://your-proxy.vercel.app
